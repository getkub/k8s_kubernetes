      "parameters": {
        "jsCode": "const alerts = $input.first().json.data || [];\nif (alerts.length === 0) {\n  return [];\n}\n\nlet summary = `Found ${alerts.length} open SOC alerts:\\n\\n`;\nalerts.forEach(alert => {\n  summary += `- ${alert.signal.rule.name || 'Unknown Rule'} (Severity: ${alert.signal.rule.severity || 'Unknown'})\\n`;\n});\n\nreturn [{ json: { summary: summary, alertCount: alerts.length, rawAlerts: alerts } }];"
